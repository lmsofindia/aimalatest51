{{!
    EdzLeaderboard — horizontal layout.

    Top 3 highlighted on a coloured panel at left; ranks 4+ as a tight list at
    right. Wide but short, so it won't run down a dashboard. When the current
    user is outside the shown list, their own standing is appended at the right.

    Context: p1, p2, p3 (row or null), rest[], hasrest, showmyrow, myrow.

    @package    block_edzleaderboard
    @copyright  2026 EdzCorp
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div class="edzlb edzlb--horizontal">

    <div class="edzlb-h__left">
        <div class="edzlb-h__lead">{{#str}}pluginname, block_edzleaderboard{{/str}}</div>
        <div class="edzlb-h__top3">
            {{#p1}}
            <a href="{{profileurl}}" class="edzlb-t3 edzlb-t3--lead{{#isme}} edzlb-t3--me{{/isme}}">
                <span class="edzlb-t3__rk edzlb-t3__rk--1">{{rank}}</span>
                {{> block_edzleaderboard/avatar}}
                <span class="edzlb-t3__info">
                    <span class="edzlb-t3__name">{{name}}</span>
                    <span class="edzlb-t3__pts">{{xpformatted}} {{#str}}pointssuffix, block_edzleaderboard{{/str}}</span>
                </span>
                <span class="edzlb-t3__crown" aria-hidden="true">&#128081;</span>
            </a>
            {{/p1}}
            {{#p2}}
            <a href="{{profileurl}}" class="edzlb-t3{{#isme}} edzlb-t3--me{{/isme}}">
                <span class="edzlb-t3__rk edzlb-t3__rk--2">{{rank}}</span>
                {{> block_edzleaderboard/avatar}}
                <span class="edzlb-t3__info">
                    <span class="edzlb-t3__name">{{name}}</span>
                    <span class="edzlb-t3__pts">{{xpformatted}} {{#str}}pointssuffix, block_edzleaderboard{{/str}}</span>
                </span>
            </a>
            {{/p2}}
            {{#p3}}
            <a href="{{profileurl}}" class="edzlb-t3{{#isme}} edzlb-t3--me{{/isme}}">
                <span class="edzlb-t3__rk edzlb-t3__rk--3">{{rank}}</span>
                {{> block_edzleaderboard/avatar}}
                <span class="edzlb-t3__info">
                    <span class="edzlb-t3__name">{{name}}</span>
                    <span class="edzlb-t3__pts">{{xpformatted}} {{#str}}pointssuffix, block_edzleaderboard{{/str}}</span>
                </span>
            </a>
            {{/p3}}
        </div>
    </div>

    <div class="edzlb-h__right">
        {{#hasrest}}
        <div class="edzlb-rows">
            {{#rest}}
            <a href="{{profileurl}}" class="edzlb-row{{#isme}} edzlb-row--me{{/isme}}">
                <span class="edzlb-row__rank">{{rank}}</span>
                {{> block_edzleaderboard/avatar}}
                <span class="edzlb-row__who">
                    <span class="edzlb-row__name">{{name}}{{#isme}} <span class="edzlb-you">{{#str}}youlabel, block_edzleaderboard{{/str}}</span>{{/isme}}</span>
                    <span class="edzlb-row__sub">{{levellabel}}</span>
                </span>
                <span class="edzlb-row__pts">{{xpformatted}}<small> {{#str}}pointssuffix, block_edzleaderboard{{/str}}</small></span>
            </a>
            {{/rest}}
        </div>
        {{/hasrest}}
        {{^hasrest}}
        <div class="edzlb-empty">{{#str}}noentries, block_edzleaderboard{{/str}}</div>
        {{/hasrest}}

        {{#showmyrow}}
        <div class="edzlb-yourrank">{{#str}}yourrank, block_edzleaderboard{{/str}}</div>
        <div class="edzlb-rows edzlb-rows--me">
            {{#myrow}}
            <a href="{{profileurl}}" class="edzlb-row edzlb-row--me">
                <span class="edzlb-row__rank">{{rank}}</span>
                {{> block_edzleaderboard/avatar}}
                <span class="edzlb-row__who">
                    <span class="edzlb-row__name">{{name}} <span class="edzlb-you">{{#str}}youlabel, block_edzleaderboard{{/str}}</span></span>
                    <span class="edzlb-row__sub">{{levellabel}}</span>
                </span>
                <span class="edzlb-row__pts">{{xpformatted}}<small> {{#str}}pointssuffix, block_edzleaderboard{{/str}}</small></span>
            </a>
            {{/myrow}}
        </div>
        {{/showmyrow}}
    </div>

</div>
