<XMLDB xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" PATH="local/edzdashboardview/db" VERSION="2025081601" COMMENT="XMLDB file for Moodle local/edzdashboardview" xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">

    <TABLES>
        <TABLE NAME="usage_log" COMMENT="Stores system usage stats">
            <FIELDS>
               <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
                <FIELD NAME="timestamp" TYPE="int" LENGTH="10" NOTNULL="true" />
                <FIELD NAME="cpu_usage" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" />
                <FIELD NAME="memory_usage" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" />
                <FIELD NAME="storage_usage" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" />
                
                
            </FIELDS>

            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>
    </TABLES>
</XMLDB>
