<!-- Site Section Tab -->
<div class="site-tab">

  <!-- Charts Section -->
  <div class="container-fluid dashboard-charts">
    <div class="row">
      <!-- Site Basic Info -->
      <div class="col-md-6 mb-4">
        <div class="chart-card">
          <div class="site-basic-info card shadow-sm p-3" style="max-width:700px;">
            <h5>{{#str}} sitebasicinfo, local_edzdashboardview {{/str}}</h5>

            <div class="d-flex justify-content-between border-bottom py-2">
              <span>Theme designer mode</span>
              <span id="theme-mode" class="badge bg-danger text-white">Disabled</span>
            </div>

            <div class="d-flex justify-content-between border-bottom py-2">
              <span>Debugging</span>
              <span id="debug-mode" class="badge bg-danger text-white">Disabled</span>
            </div>

            <div class="d-flex justify-content-between border-bottom py-2">
              <span>{{#str}} additionalplugin, local_edzdashboardview {{/str}}</span>
              <strong id="plugin-count">0</strong>
            </div>

            <div class="d-flex justify-content-between border-bottom py-2">
              <span>{{#str}} modlesourcedir, local_edzdashboardview {{/str}}</span>
              <strong id="srcdir-size">0MB Used</strong>
            </div>

            <div class="d-flex justify-content-between py-2">
              <span>{{#str}} modledatadir, local_edzdashboardview {{/str}}</span>
              <strong id="datadir-size">0MB Used</strong>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Usage Tabs -->
    <div class="row">
      <div class="col-md-12 mb-4">
        <div class="chart-card">

          <ul class="nav nav-tabs simple-tabs" id="usageTabs" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active"
                      id="live-tab"
                      data-bs-toggle="tab"
                      data-bs-target="#live"
                      type="button"
                      role="tab"
                      aria-controls="live"
                      aria-selected="true">
                {{#str}} liveusage, local_edzdashboardview {{/str}}
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link"
                      id="last24h-tab"
                      data-bs-toggle="tab"
                      data-bs-target="#last24h"
                      type="button"
                      role="tab"
                      aria-controls="last24h"
                      aria-selected="false">
                {{#str}} last24usages, local_edzdashboardview {{/str}}
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link"
                      id="recommended-tab"
                      data-bs-toggle="tab"
                      data-bs-target="#recommended"
                      type="button"
                      role="tab"
                      aria-controls="recommended"
                      aria-selected="false">
                {{#str}} recommendedplugin, local_edzdashboardview {{/str}}
              </button>
            </li>
          </ul>

          <div class="tab-content mt-3" id="usageTabsContent">

            <!-- Live usage -->
            <div class="tab-pane fade show active"
                 id="live"
                 role="tabpanel"
                 aria-labelledby="live-tab">
              <div class="status-item mb-3">
                <i class="fas fa-microchip me-2"></i>
                <strong>CPU:</strong>
                <div class="progress mt-1"><div class="progress-bar bg-success"></div></div>
              </div>

              <div class="status-item mb-3">
                <i class="fas fa-memory me-2"></i>
                <strong>Memory:</strong>
                <div class="progress mt-1"><div class="progress-bar bg-warning"></div></div>
              </div>

              <div class="status-item mb-3">
                <i class="fas fa-hdd me-2"></i>
                <strong>Storage:</strong>
                <div class="progress mt-1"><div class="progress-bar bg-info"></div></div>
              </div>

              <div class="status-item mb-3">
                <i class="fas fa-user-circle me-2"></i>
                <span class="badge bg-danger">Live users (last 30 min) 0</span>
              </div>
            </div>

            <!-- Last 24 hours -->
            <div class="tab-pane fade"
                 id="last24h"
                 role="tabpanel"
                 aria-labelledby="last24h-tab">
              <h5>{{#str}} hourse24usageChart, local_edzdashboardview {{/str}}</h5>
              <canvas id="usageChart"></canvas>
            </div>

            <!-- Recommended plugins -->
            <div class="tab-pane fade"
                 id="recommended"
                 role="tabpanel"
                 aria-labelledby="recommended-tab">
              <p>Recommended plugins content goes here...</p>
            </div>

          </div>

        </div>
      </div>
    </div>
  </div>
</div>
