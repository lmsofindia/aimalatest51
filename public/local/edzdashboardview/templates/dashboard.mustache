<div class="container-fluid mt-3">

  <!-- Top Tabs -->
  <ul class="nav nav-tabs simple-tabs" id="mainTabs" role="tablist">
    {{#tabs}}
      <li class="nav-item" role="presentation">
        <button class="nav-link {{#active}}active{{/active}}" 
                id="{{id}}-tab" 
                data-bs-toggle="tab" 
                data-bs-target="#{{id}}" 
                type="button" 
                role="tab" 
                aria-controls="{{id}}" 
                aria-selected="{{#active}}true{{/active}}{{^active}}false{{/active}}">
          {{label}}
        </button>
      </li>
    {{/tabs}}
  </ul>

  <!-- Tab Content -->
  <div class="tab-content mt-3" id="mainTabsContent">
    {{#tabs}}
      <div class="tab-pane fade {{#active}}show active{{/active}}" 
           id="{{id}}" 
           role="tabpanel" 
           aria-labelledby="{{id}}-tab">
        {{{content}}}
      </div>
    {{/tabs}}
  </div>

</div>
