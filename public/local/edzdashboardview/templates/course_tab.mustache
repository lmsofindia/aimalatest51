<!-- Course Section Tab -->
<div class="course-tab">

  <!-- Range Selector -->
  <div class="mb-3 text-end">
    <div class="btn-group" role="group" aria-label="Course range selector">
      <input type="radio" class="btn-check" name="range-course" id="range-course-1day" value="1day" autocomplete="off" checked>
      <label class="btn btn-sm btn-outline-secondary rounded-pill px-3 me-2" for="range-course-1day">
        {{#str}} today, local_edzdashboardview {{/str}}
      </label>

      <input type="radio" class="btn-check" name="range-course" id="range-course-7day" value="7day" autocomplete="off">
      <label class="btn btn-sm btn-outline-secondary rounded-pill px-3 me-2" for="range-course-7day">
        {{#str}} sevendays, local_edzdashboardview {{/str}}
      </label>

      <input type="radio" class="btn-check" name="range-course" id="range-course-30day" value="30day" autocomplete="off">
      <label class="btn btn-sm btn-outline-secondary rounded-pill px-3 me-2" for="range-course-30day">
        {{#str}} thirtydays, local_edzdashboardview {{/str}}
      </label>

      <input type="radio" class="btn-check" name="range-course" id="range-course-1year" value="1year" autocomplete="off">
      <label class="btn btn-sm btn-outline-secondary rounded-pill px-3 me-2" for="range-course-1year">
        {{#str}} oneyear, local_edzdashboardview {{/str}}
      </label>
    </div>
  </div>

  <!-- Info Cards -->
  <div class="row equal-card-row">

    <!-- Courses Created -->
    <div class="col-md-3 mb-2">
      <div class="card info-card shadow-sm">
        <div class="card-body hover-card">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h3 class="card-title mb-1" id="card-coursescreate"></h3>
              <p class="card-text mb-0">{{#str}} coursescreated, local_edzdashboardview {{/str}}</p>
            </div>
            <div class="icon-box bg-primary">
              <i class="fa fa-book"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Enrolled vs Completed -->
    <div class="col-md-3 mb-2">
      <div class="card info-card shadow-sm">
        <div class="card-body hover-card">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h3 class="card-title mb-1" id="card-enrolvscompleted"></h3>
              <p class="card-text mb-1">{{#str}} enrolvscomplete, local_edzdashboardview {{/str}}</p>
              <small id="card-enrolvscomplete-details"></small>
            </div>
            <div class="icon-box bg-success">
              <i class="fa fa-check-circle"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Top Course Info -->
    <div class="col-md-3 mb-2">
      <div class="card info-card shadow-sm">
        <div class="card-body hover-card">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h5 class=" mb-1" id="card-topcoursess"></h5>
              <p class="card-text mb-0">{{#str}} topcourseinfo, local_edzdashboardview {{/str}}</p>
              <small id="card-topcourses-detail"></small>
            </div>
            <div class="icon-box bg-warning">
              <!--<img id="card-topcourses-image" src="" alt="" class="rounded" width="40" height="40">-->
              <i class="fa fa-course"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Top Category Info -->
    <div class="col-md-3 mb-2">
      <div class="card info-card shadow-sm">
        <div class="card-body hover-card">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h5 class=" mb-1" id="card-topcategoryinfo"></h5>
              <p class="card-text mb-0">{{#str}} topcategoryinfo, local_edzdashboardview {{/str}}</p>
              <small id="card-topcategory-detail"></small>
            </div>
            <div class="icon-box bg-danger">
              <i class="fa fa-check-circle"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Charts -->
  <div class="container-fluid dashboard-charts">
    <div class="row">
      <div class="col-md-6 mb-4">
        <div class="chart-card">
          <h5>{{#str}} topcourselist, local_edzdashboardview {{/str}}</h5>
          <div id="topcourseslist"></div>
        </div>
      </div>
      <div class="col-md-6 mb-4">
        <div class="chart-card">
          <h5>{{#str}} topcategorylist, local_edzdashboardview {{/str}}</h5>
          <div id="topcategorylist"></div>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6 mb-4">
        <div class="chart-card">
          <h5>{{#str}} coursecreatedstatistics, local_edzdashboardview {{/str}}</h5>
          <canvas id="courseChart"></canvas>
        </div>
      </div>
      <div class="col-md-6 mb-4">
        <div class="chart-card p-3">
          <h5>{{#str}} sitebasicinfo, local_edzdashboardview {{/str}}</h5>
        
          <div class="d-flex justify-content-between mt-3 mb-3 border-bottom pb-3">
            <span>Total badges Issued</span>
            <span id="total-badges"></span>
          </div>
       
          <div class="d-flex justify-content-between mb-3 border-bottom pb-3">
            <span>Total forum Issued</span>
            <span id="total-forum"></span>
          </div>
          
          <div class="d-flex justify-content-between mb-3 border-bottom pb-3">
            <span>Total assignment Issued</span>
            <span id="total-assignment"></span>
          </div>
          
          <div class="d-flex justify-content-between mb-3 border-bottom pb-3">
            <span>Total quiz Submitted</span>
            <span id="total-quizsubmitted"></span>
          </div>
        
          <div class="d-flex justify-content-between mb-3">
            <span>Total quiz Attempted</span>
            <span id="total-quizattempted"></span>
          </div>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-12 mb-4">
        <div class="chart-card">
          <h5>{{#str}} coursecompletedstatistics, local_edzdashboardview {{/str}}</h5>
          <canvas id="enrolVsCompleteChart"></canvas>
        </div>
      </div>
    </div>
  </div>
</div>
