  background: linear-gradient(135deg, #f9fbff 0%, #e6f2ff 100%);
  border-radius: 0 0 50% 50% / 5%;
}

/* Title */
.lce-title {
  font-size: 2.5rem;
  line-height: 1.3;
}

/* Mobile adjustments */
@media (max-width: 767.98px) {
  .lce-title {
    font-size: 1.75rem;
  }
  .lce-hero-overlay {
    border-radius: 0;
    padding: 2rem 1rem;
  }
}


