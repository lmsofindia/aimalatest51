  padding: 12px;
  gap: 8px;
}

.course-summary__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1 1 100px;
  min-width: 80px;
}

.course-summary__text {
  font-weight: bold;
  margin-bottom: 4px;
}

.course-summary__caption-text {
  font-size: 0.875rem;
  color: #666;
  text-align: center;
}

.course-summary__divider {
  width: 1px;
  background-color: #ccc;
  height: 40px;
}

@media (max-width: 768px) {
  .course-summary {
    flex-wrap: nowrap;
  }
