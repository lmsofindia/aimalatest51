<div id="lc-container" class="local-edzallcourse container-fluid py-3">
        <div class="row">
          {{#filtersenabled}}
          <!-- Sidebar Filters -->
          <aside id="lc-sidebar" class="col-12 col-md-4 col-lg-3 mb-4 mb-md-0">

            <div class="mb-3">
    
      </div>

      <div id="lc-filters" class="accordion">
        {{#filters}}
        <div class="lc-filter card mb-2">
          <div class="card-header p-2" id="heading-{{shortname}}">
            <button class="btn btn-link w-100 d-flex justify-content-between align-items-center text-start lc-filter-header"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#collapse-{{shortname}}"
                    aria-expanded="true"
                    aria-controls="collapse-{{shortname}}">
              <span>{{name}}</span>
              <span class="toggle-icon">+</span>
            </button>
          </div>
          <div id="collapse-{{shortname}}" class="collapse show" aria-labelledby="heading-{{shortname}}">
            <div class="card-body p-2">
              {{#options}}
              <div class="form-check">
                <input class="form-check-input pc-filter-field"
                       type="checkbox"
                       value="{{value}}"
                       id="filter-{{shortname}}-{{value}}"
                       data-field="{{shortname}}" {{#checked}}checked{{/checked}}>
                <label class="form-check-label" for="filter-{{shortname}}-{{value}}">
                  {{{label}}}
                </label>
              </div>
              {{/options}}
            </div>
          </div>
        </div>
        {{/filters}}
      </div>
    </aside>
    {{/filtersenabled}}

    {{^filtersenabled}}
    <div class="col-12">
      <div class="alert alert-warning">{{#str}}nofilterenabled, local_edzallcourse{{/str}}</div>
    </div>
    {{/filtersenabled}}

    <main class="col-12 col-md-8 col-lg-9">
      <div id="pcattree-results">
      </div>
      <div id="courselist-results">
      
      </div>
    </main>
  </div>
</div>

{{#js}}
require(['local_edzallcourse/allcat'], function(mod) {
    mod.init();
});

require(['local_edzallcourse/subcourse'], function(subcat) {
    subcat.init();
});
{{/js}}
