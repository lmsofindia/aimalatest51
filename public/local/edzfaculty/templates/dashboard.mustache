{{!
    This file is part of the local_edzfaculty plugin for Moodle.
    Faculty dashboard (v2 redesign).
    @template local_edzfaculty/dashboard
}}
<div class="edzf" data-region="edzfaculty">
    <script type="application/json" data-region="edzf-data">{{{datajson}}}</script>

    <div class="edzf-greet">{{#str}}dashboardtitle, local_edzfaculty{{/str}}</div>
    <div class="edzf-gsub"><span class="edzf-muted">{{teachername}}</span></div>

    {{! KPIs }}
    <div class="edzf-kgrid">
        <div class="edzf-card edzf-kpi k-crit">
            <div class="edzf-kic"><svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></div>
            <div class="edzf-kv">{{kpi.tograde}}</div><div class="edzf-kl">{{#str}}kpi_tograde, local_edzfaculty{{/str}}</div>
        </div>
        <div class="edzf-card edzf-kpi k-warn">
            <div class="edzf-kic"><svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
            <div class="edzf-kv">{{kpi.unanswered}}</div><div class="edzf-kl">{{#str}}kpi_unanswered, local_edzfaculty{{/str}}</div>
        </div>
        <div class="edzf-card edzf-kpi k-crit">
            <div class="edzf-kic"><svg viewBox="0 0 24 24"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h16.9a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4M12 17h.01"/></svg></div>
            <div class="edzf-kv">{{kpi.atrisk}}</div><div class="edzf-kl">{{#str}}kpi_atrisk, local_edzfaculty{{/str}}{{#showai}} <span class="edzf-pill ai">AI</span>{{/showai}}</div>
        </div>
        <div class="edzf-card edzf-kpi k-blue{{#kpi.nextclasssoon}} pulse{{/kpi.nextclasssoon}}">
            <div class="edzf-kic"><svg viewBox="0 0 24 24"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg></div>
            {{#kpi.nextclass}}<div class="edzf-kv">{{time}}</div><div class="edzf-kl">{{#str}}kpi_nextclass, local_edzfaculty{{/str}}</div><div class="edzf-km">{{name}}{{#url}} · <a href="{{url}}">{{#str}}join, local_edzfaculty{{/str}}</a>{{/url}}</div>{{/kpi.nextclass}}
            {{^kpi.nextclass}}<div class="edzf-kv edzf-muted">—</div><div class="edzf-kl">{{#str}}kpi_nextclass, local_edzfaculty{{/str}}</div>{{/kpi.nextclass}}
        </div>
    </div>

    {{! Worklist + Urgent Today }}
    <div class="edzf-two">
        <section class="edzf-card">
            <div class="edzf-card-h"><h2 class="edzf-h2">{{#str}}needsattention, local_edzfaculty{{/str}}</h2></div>
            <div class="edzf-tabs">
                <button class="edzf-tab crit active" data-tab="grade">{{#str}}tab_grading, local_edzfaculty{{/str}} <span class="edzf-cnt">{{count_grading}}</span></button>
                <button class="edzf-tab" data-tab="disc">{{#str}}tab_discussions, local_edzfaculty{{/str}} <span class="edzf-cnt">{{count_discussions}}</span></button>
                <button class="edzf-tab" data-tab="risk">{{#str}}tab_atrisk, local_edzfaculty{{/str}} <span class="edzf-cnt">{{count_atrisk}}</span></button>
                <button class="edzf-tab" data-tab="over">{{#str}}tab_overdue, local_edzfaculty{{/str}} <span class="edzf-cnt">{{count_overdue}}</span></button>
            </div>
            <div class="edzf-pane active" data-pane="grade">
                {{#grading}}<div class="edzf-row"><span class="edzf-mk {{sev}}"></span><div class="edzf-rm"><div class="edzf-rt">{{name}} <span class="edzf-pill sec">{{section}}</span>{{#showai}} <span class="edzf-pill ai">✦ AI</span>{{/showai}}</div><div class="edzf-rs">{{#str}}submissions, local_edzfaculty, {{pending}}{{/str}}</div></div><span class="edzf-pill {{sev}}">{{age}}</span><a class="edzf-btn sm" href="{{url}}">{{#str}}grade, local_edzfaculty{{/str}}</a></div>{{/grading}}
                {{^hasgrading}}<div class="edzf-empty">{{#str}}nogradingdue, local_edzfaculty{{/str}}</div>{{/hasgrading}}
            </div>
            <div class="edzf-pane" data-pane="disc">
                {{#discussions}}<div class="edzf-row"><span class="edzf-mk {{sev}}"></span><div class="edzf-rm"><div class="edzf-rt">{{name}} <span class="edzf-pill sec">{{section}}</span></div></div><span class="edzf-pill {{sev}}">{{age}}</span><a class="edzf-btn sm" href="{{url}}">{{#str}}reply, local_edzfaculty{{/str}}</a></div>{{/discussions}}
                {{^hasdiscussions}}<div class="edzf-empty">{{#str}}nounanswered, local_edzfaculty{{/str}}</div>{{/hasdiscussions}}
            </div>
            <div class="edzf-pane" data-pane="risk">
                {{#atriskrows}}<div class="edzf-row edzf-clickable" data-action="student" data-userid="{{userid}}" data-courseid="{{courseid}}" data-name="{{fullname}}" data-initials="{{initials}}" data-section="{{section}}" data-attendance="{{attendance}}" data-avgscore="{{avgscore}}" data-lastaccess="{{lastaccess}}" data-missed="{{missed}}" data-forumposts="{{forumposts}}" data-trend="{{trend}}" data-level="{{levellabel}}" data-reasons="{{reasonsjson}}" data-profileurl="{{profileurl}}"><span class="edzf-mk risk-{{level}}"></span><div class="edzf-rm"><div class="edzf-rt">{{fullname}} <span class="edzf-pill sec">{{section}}</span></div><div class="edzf-rs">{{reasonssummary}}</div></div><span class="edzf-pill risk-{{level}}">{{levellabel}}</span><button class="edzf-btn sm" data-action="student-btn">{{#str}}view, local_edzfaculty{{/str}}</button></div>{{/atriskrows}}
                {{^hasatrisk}}<div class="edzf-empty">{{#str}}noatrisk, local_edzfaculty{{/str}}</div>{{/hasatrisk}}
            </div>
            <div class="edzf-pane" data-pane="over">
                {{#overdue}}<div class="edzf-row"><span class="edzf-mk hi"></span><div class="edzf-rm"><div class="edzf-rt">{{name}} <span class="edzf-pill sec">{{section}}</span></div><div class="edzf-rs">{{nonsub}} not submitted · {{due}}</div></div><a class="edzf-btn sm ghost" href="{{url}}">{{#str}}view, local_edzfaculty{{/str}}</a></div>{{/overdue}}
                {{^hasoverdue}}<div class="edzf-empty">{{#str}}nooverdue, local_edzfaculty{{/str}}</div>{{/hasoverdue}}
            </div>
        </section>

        <section class="edzf-card edzf-urgent">
            <div class="edzf-card-h"><h2 class="edzf-h2"><span class="edzf-bl"></span>{{#str}}todayupcoming, local_edzfaculty{{/str}}</h2></div>
            <div class="edzf-card-b">
                {{#timeline}}<div class="edzf-tl {{#soon}}now{{/soon}}{{#isexam}}exam{{/isexam}}"><div class="edzf-tm">{{date}}</div><div class="edzf-tbd"><div class="edzf-tt">{{name}}</div><div class="edzf-ts">{{section}}</div>{{#soon}}<span class="edzf-tag now">{{reltime}}</span> {{/soon}}{{#islive}}<span class="edzf-tag zoom">Zoom</span>{{/islive}}{{#isexam}}<span class="edzf-tag exam">{{#str}}tag_exam, local_edzfaculty{{/str}}</span>{{/isexam}}{{#joinurl}}<a class="edzf-btn sm red" href="{{.}}">{{#str}}join, local_edzfaculty{{/str}}</a>{{/joinurl}}</div></div>{{/timeline}}
                {{^hastimeline}}<div class="edzf-empty">{{#str}}notimeline, local_edzfaculty{{/str}}</div>{{/hastimeline}}
            </div>
        </section>
    </div>

    {{! Course Focus }}
    <section class="edzf-card edzf-focus">
        <div class="edzf-card-h"><h2 class="edzf-h2">{{#str}}coursefocus, local_edzfaculty{{/str}}</h2><span class="edzf-ctx" data-region="cf-ctx">{{focusall.ctx}}</span>
            <div class="edzf-sel"><label for="edzf-course">{{labels.course}}</label>
                <select id="edzf-course" class="edzf-select" data-action="course-focus"><option value="0">{{#str}}allcourses, local_edzfaculty{{/str}} ({{coursecount}})</option>{{#courseoptions}}<option value="{{id}}">{{label}}</option>{{/courseoptions}}</select>
            </div>
        </div>
        <div class="edzf-card-b">
            <div class="edzf-sg">
                <div class="edzf-st blue"><span class="edzf-sti">◎</span><div><div class="edzf-stv" data-region="cf-live">{{focusall.live}}</div><div class="edzf-stl">{{#str}}stat_live, local_edzfaculty{{/str}}</div></div></div>
                <div class="edzf-st crit"><span class="edzf-sti">✎</span><div><div class="edzf-stv" data-region="cf-assign">{{focusall.assign}}</div><div class="edzf-stl">{{#str}}stat_assign, local_edzfaculty{{/str}}</div></div></div>
                <div class="edzf-st amber"><span class="edzf-sti">❋</span><div><div class="edzf-stv" data-region="cf-disc">{{focusall.disc}}</div><div class="edzf-stl">{{#str}}stat_disc, local_edzfaculty{{/str}}</div></div></div>
                <div class="edzf-st brand"><span class="edzf-sti">▤</span><div><div class="edzf-stv" data-region="cf-quiz">{{focusall.quiz}}</div><div class="edzf-stl">{{#str}}stat_quiz, local_edzfaculty{{/str}}</div></div></div>
            </div>
            <div class="edzf-qlbl" data-region="cf-qalbl">{{focusall.label}}</div>
            <div class="edzf-q">
                <a class="edzf-qa red" data-qa="review" href="{{focusall.actions.review}}"><svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>{{#str}}qa_review, local_edzfaculty{{/str}}</a>
                <a class="edzf-qa" data-qa="attendance" href="{{focusall.actions.attendance}}"><svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><rect x="3" y="4" width="18" height="18" rx="2"/></svg>{{#str}}qa_attendance, local_edzfaculty{{/str}}</a>
                <a class="edzf-qa" data-qa="discuss" href="{{focusall.actions.discuss}}"><svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>{{#str}}qa_discuss, local_edzfaculty{{/str}}</a>
                <a class="edzf-qa" data-qa="upload" href="{{focusall.actions.upload}}"><svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>{{#str}}qa_upload, local_edzfaculty{{/str}}</a>
                <a class="edzf-qa" data-qa="schedule" href="{{focusall.actions.schedule}}"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>{{#str}}qa_schedule, local_edzfaculty{{/str}}</a>
                <a class="edzf-qa" data-qa="assess" href="{{focusall.actions.assess}}"><svg viewBox="0 0 24 24"><path d="M12 20V10M18 20V4M6 20v-4"/></svg>{{#str}}qa_assess, local_edzfaculty{{/str}}</a>
            </div>
        </div>
    </section>

    {{! My Courses }}
    <section class="edzf-card">
        <div class="edzf-card-h"><h2 class="edzf-h2">{{mycourseslabel}}</h2>
            <div class="edzf-csearch"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg><input id="edzf-csrch" placeholder="{{#str}}searchcourses, local_edzfaculty{{/str}}" data-action="course-search"></div>
        </div>
        <div class="edzf-card-b">
            <div class="edzf-cgrid" data-region="cgrid">
                {{#courses}}
                <a class="edzf-course" href="{{url}}" data-search="{{name}} {{shortname}}">
                    <div class="edzf-ct">{{name}}</div><div class="edzf-cc">{{shortname}}</div>
                    <div class="edzf-bar"><i style="width:{{delivered}}%"></i></div>
                    <div class="edzf-cstat"><div><b>{{students}}</b><span>{{labels.students}}</span></div><div><b>{{avgscore}}%</b><span>{{#str}}avgscore, local_edzfaculty{{/str}}</span></div><div><b class="edzf-risk">{{atrisk}}</b><span>{{#str}}atrisklabel, local_edzfaculty{{/str}}</span></div></div>
                    <div class="edzf-creport">{{#str}}opencoursereport, local_edzfaculty{{/str}}</div>
                </a>
                {{/courses}}
            </div>
            <div class="edzf-empty" data-region="cempty" style="display:none">{{#str}}nocoursematch, local_edzfaculty{{/str}}</div>
            {{^hascourses}}<div class="edzf-empty">{{#str}}noaccess, local_edzfaculty{{/str}}</div>{{/hascourses}}
        </div>
    </section>

    {{! Insight }}
    <div class="edzf-ins">
        <section class="edzf-card">
            <div class="edzf-card-h"><h2 class="edzf-h2">{{#str}}engagementtitle, local_edzfaculty{{/str}}</h2>
                {{#lastupdated}}<span class="edzf-ctx">{{.}}</span>{{/lastupdated}}
                <div class="edzf-sel"><label for="edzf-egsel">{{labels.course}}</label><select id="edzf-egsel" class="edzf-select" data-action="eng-select"><option value="0">{{#str}}allcourses, local_edzfaculty{{/str}}</option>{{#courseoptions}}<option value="{{id}}">{{label}}</option>{{/courseoptions}}</select></div>
            </div>
            <div class="edzf-card-b">
                <div class="edzf-eg">
                    {{#engagetiles}}<div class="edzf-e"><div class="edzf-ev" data-eng-key="{{key}}">{{value}}</div><div class="edzf-el">{{label}}</div><div class="edzf-et {{trendclass}}" data-eng-trend="{{key}}">{{trendtext}}</div></div>{{/engagetiles}}
                </div>
                {{#showai}}<div class="edzf-ainote"><span class="i">✦</span><p data-region="eng-ai"></p></div>{{/showai}}
            </div>
        </section>
        <section class="edzf-card">
            <div class="edzf-card-h"><h2 class="edzf-h2">{{#str}}sectionperformance, local_edzfaculty{{/str}}</h2></div>
            <div class="edzf-card-b">
                <div class="edzf-hbars">
                    {{#sectionbars}}<div class="edzf-hb"><div class="edzf-nm">{{name}}</div><div class="edzf-track"><i class="{{cls}}" style="width:{{pct}}%"></i></div><div class="edzf-pc">{{pct}}%</div></div>{{/sectionbars}}
                    {{^sectionbars}}<div class="edzf-empty">{{#str}}nodata, local_edzfaculty{{/str}}</div>{{/sectionbars}}
                </div>
            </div>
        </section>
    </div>
</div>
