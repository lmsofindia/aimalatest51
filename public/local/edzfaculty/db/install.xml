<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/edzfaculty/db" VERSION="20260718" COMMENT="local_edzfaculty install schema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_edzfaculty_cache" COMMENT="Per-student per-course derived metrics (rebuilt by scheduled task)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="attendancepct" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="avgscore" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="scoretrend" TYPE="number" LENGTH="6" DECIMALS="2" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="lastaccess" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="misseddeadlines" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="forumposts" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="contentviews" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="riskscore" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="risklevel" TYPE="char" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="riskreasons" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseuser" TYPE="unique" FIELDS="courseid, userid"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseidix" UNIQUE="false" FIELDS="courseid"/>
        <INDEX NAME="useridix" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="risklevelix" UNIQUE="false" FIELDS="risklevel"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_edzfaculty_coursecache" COMMENT="Per-course engagement rollups (rebuilt by scheduled task)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="activestudentspct" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="contentviews" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="assessmentstaken" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="avgscore" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="activestudentsprev" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="contentviewsprev" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="assessmentstakenprev" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="avgscoreprev" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="atriskcount" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="contentdeliveredpct" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseidk" TYPE="unique" FIELDS="courseid"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
