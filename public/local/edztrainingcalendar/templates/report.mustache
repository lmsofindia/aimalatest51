<div class="container-fluid edz-calendar-report edz-report-page">

  <!-- Breadcrumb -->

  <!-- 4 Stat Boxes -->
  <!-- 4 Stat Boxes -->
<div class="row g-3 mb-4 text-center edz-stat-cards">
  <div class="col-md-3 col-sm-6">
    <div class="p-3 rounded shadow-sm edz-box edz-box-allocated">
      <i class="fa fa-calendar-check fa-2x mb-2"></i>
      <h6 class="fw-bold text-dark">Allocated</h6>
      <h3 class="fw-bold mb-0">{{stats.allocated}}</h3>
    </div>
  </div>
  <div class="col-md-3 col-sm-6">
    <div class="p-3 rounded shadow-sm edz-box edz-box-completed">
      <i class="fa fa-check-circle fa-2x mb-2"></i>
      <h6 class="fw-bold text-dark">Completed</h6>
      <h3 class="fw-bold mb-0">{{stats.completed}}</h3>
    </div>
  </div>
  <div class="col-md-3 col-sm-6">
    <div class="p-3 rounded shadow-sm edz-box edz-box-inprogress">
      <i class="fa fa-hourglass-half fa-2x mb-2"></i>
      <h6 class="fw-bold text-dark">In Progress</h6>
      <h3 class="fw-bold mb-0">{{stats.inprogress}}</h3>
    </div>
  </div>
  <div class="col-md-3 col-sm-6">
    <div class="p-3 rounded shadow-sm edz-box edz-box-notstarted">
      <i class="fa fa-clock fa-2x mb-2"></i>
      <h6 class="fw-bold text-dark">Not Started</h6>
      <h3 class="fw-bold mb-0">{{stats.notstarted}}</h3>
    </div>
  </div>
</div>


  <!-- Charts Section -->
  <div class="row mb-4">
    <div class="col-md-6">
      <canvas id="edztrainingchart" height="200"></canvas>
    </div>
    <div class="col-md-6">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <h5>Trends</h5>
        <select id="barFilter" class="form-select form-select-sm w-auto">
          <option value="week">This Week</option>
          <option value="month">This Month</option>
          <option value="3months">Last 3 Months</option>
          <option value="year">This Year</option>
        </select>
      </div>
      <canvas id="edztrainingbarchart" height="200"></canvas>
    </div>
  </div>

  <!-- Table -->
  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
        <!-- Search box (left) -->
        <div class="flex-grow-1 me-2" style="max-width: 400px;">
            <input type="text" id="edz-search" class="form-control" placeholder="Type to search...">
        </div>

        <!-- Download button (right) -->
        <div>
            <a href="{{config.wwwroot}}/local/edztrainingcalendar/report.php?download=1"
            class="btn btn-secondary">
            <i class="fa fa-download"></i> Download CSV
            </a>
        </div>
    </div>

  <form id="edz-report-form" method="post">
    <table id="edz-report-table" class="generaltable table table-striped table-hover">
      <thead>
        <tr>
          <th>SL#</th>
          <th>Course</th>
          <th>Student</th>
          <th>Email</th>
          <th>Allocated</th>
          <th>Start</th>
          <th>Expected</th>
          <th>Actual</th>
          <th>Status</th>
          <th>Grade</th>
          <th><input type="checkbox" id="selectall"></th>
        </tr>
      </thead>
      <tbody>
        {{#records}}
        <tr>
          <td>{{sl}}</td>
          <td>{{course}}</td>
          <td>{{student}}</td>
          <td>{{email}}</td>
          <td>{{allocated}}</td>
          <td>{{start}}</td>
          <td>{{expected}}</td>
          <td>{{actual}}</td>
          <td>{{status}}</td>
          <td>{{grade}}</td>
          <td><input type="checkbox" name="selected[]" value="{{userid}}"></td>
        </tr>
        {{/records}}
      </tbody>
    </table>
    <div id="edz-pagination" class="mt-3"></div>
    <button type="submit" name="sendreminder" class="btn btn-primary mt-2">Send Reminder</button>
  </form>
</div>
