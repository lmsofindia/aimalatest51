{{!
    This file is part of Moodle - http://moodle.org/

    @template local_reportpanel/cert_full

    Certificate reports, full mode: category/course pickers + issued-count table.

    Example context (json):
    {
        "backurl":"#","intro":"Choose a course.","actionurl":"#","installed":true,
        "categories":[{"id":1,"name":"Cat","selected":true}],
        "courses":[{"id":2,"name":"Course","selected":false}],
        "hascourses":true,"categoryid":1,"courseid":0,"hascourse":false,
        "coursename":"","rows":[],"hasrows":false
    }
}}
<div class="reportpanel-report">
    <p><a href="{{backurl}}"><i class="fa fa-arrow-left"></i> {{#str}}backtopanel, local_reportpanel{{/str}}</a></p>
    <p class="reportpanel-intro text-muted">{{intro}}</p>

    {{^installed}}
    <div class="alert alert-warning">{{#str}}cert_notinstalled, local_reportpanel{{/str}}</div>
    {{/installed}}

    {{#installed}}
    <form method="get" action="{{actionurl}}" class="reportpanel-filterbar">
        <div class="form-group">
            <label for="reportpanel-category">{{#str}}selectcategory, local_reportpanel{{/str}}</label>
            <select class="form-control" id="reportpanel-category" name="categoryid">
                <option value="0">{{#str}}choosecategory, local_reportpanel{{/str}}</option>
                {{#categories}}
                <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                {{/categories}}
            </select>
        </div>
        <div class="form-group">
            <label for="reportpanel-course">{{#str}}selectcourse, local_reportpanel{{/str}}</label>
            <select class="form-control" id="reportpanel-course" name="courseid">
                <option value="0">{{#str}}choosecourse, local_reportpanel{{/str}}</option>
                {{#courses}}
                <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                {{/courses}}
            </select>
        </div>
        <div class="form-group">
            <button type="submit" class="btn btn-primary">{{#str}}open, local_reportpanel{{/str}}</button>
        </div>
    </form>

    {{#hascourse}}
        <h3 class="h5 mb-3">{{coursename}}</h3>
        {{#hasrows}}
        <div class="reportpanel-table-wrap">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>{{#str}}cert_name, local_reportpanel{{/str}}</th>
                        <th class="text-center">{{#str}}cert_issued, local_reportpanel{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#rows}}
                    <tr>
                        <td><a href="{{url}}">{{name}}</a></td>
                        <td class="text-center">{{issued}}</td>
                    </tr>
                    {{/rows}}
                </tbody>
            </table>
        </div>
        {{/hasrows}}
        {{^hasrows}}
        <div class="alert alert-info">{{#str}}cert_nocerts, local_reportpanel{{/str}}</div>
        {{/hasrows}}
    {{/hascourse}}
    {{/installed}}
</div>
