{{!
    Dashboard template — Course AI Manager.
    Rendered by pages/dashboard.php.
    The AMD module (dashboard.js) populates #edzai-dashboard-cms with the CM table.

    @template local_edzaiaxisfront/dashboard
    @copyright 2026 Edz LMS
    @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div class="edzai-dashboard" id="edzai-dashboard">

    {{! Header bar }}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>{{#str}}dashboard_title, local_edzaiaxisfront{{/str}}</h2>
            <p class="text-muted mb-0">{{coursename}}</p>
        </div>
        <a href="{{{wizard_url}}}" class="btn btn-primary">
            <i class="fa fa-magic"></i>
            {{#str}}wizard_launch, local_edzaiaxisfront{{/str}}
        </a>
    </div>

    {{! Status legend }}
    <div class="edzai-legend d-flex gap-3 mb-3">
        <span><i class="fa fa-circle-o text-muted"></i> Not ingested</span>
        <span><i class="fa fa-spinner fa-spin text-info"></i> Processing</span>
        <span><i class="fa fa-check-circle text-success"></i> Ready</span>
        <span><i class="fa fa-times-circle text-danger"></i> Failed</span>
    </div>

    {{! CM table — populated by dashboard.js }}
    <div id="edzai-dashboard-cms">
        <div class="text-center py-5">
            <i class="fa fa-spinner fa-spin fa-2x text-muted"></i>
            <p class="mt-2 text-muted">{{#str}}loading, core{{/str}}</p>
        </div>
    </div>

</div>
