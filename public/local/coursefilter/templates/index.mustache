<div id="lc-container" class="local-coursefilter container-fluid py-3">
  <div class="row">
    {{#filtersenabled}}
    <!-- Sidebar Filters -->
    <aside id="lc-sidebar" class="col-12 col-md-4 col-lg-3 mb-4 mb-md-0">

       <div class="mb-3">
  <!-- Heading row -->
  <h5 class="mb-2">{{#str}}filters, local_coursefilter{{/str}}</h5>

  <!-- Buttons row -->
  <div class="d-flex justify-content-between">
    <button id="lc-toggleall" class="btn btn-sm btn-outline-secondary">
      {{#str}}toggleall, local_coursefilter{{/str}}
    </button>

    <button id="lc-resetfilters" class="btn btn-sm btn-outline-danger">
      {{#str}}resetfilters, local_coursefilter{{/str}}
    </button>
  </div>
</div>


      <div id="lc-filters" class="accordion">
        {{#filters}}
        <div class="lc-filter card mb-2">
          <div class="card-header p-2" id="heading-{{shortname}}">
            <button class="btn btn-link w-100 d-flex justify-content-between align-items-center text-start lc-filter-header"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#collapse-{{shortname}}"
                    aria-expanded="true"
                    aria-controls="collapse-{{shortname}}">
              <span>{{name}}</span>
              <span class="toggle-icon">+</span>
            </button>
          </div>
          <div id="collapse-{{shortname}}" class="collapse show" aria-labelledby="heading-{{shortname}}">
            <div class="card-body p-2">
              {{#options}}
              <div class="form-check">
                <input class="form-check-input lc-filter-field"
                       type="checkbox"
                       value="{{value}}"
                       id="filter-{{shortname}}-{{value}}"
                       data-field="{{shortname}}" {{#checked}}checked{{/checked}}>
                <label class="form-check-label" for="filter-{{shortname}}-{{value}}">
                  {{{label}}}
                </label>
              </div>
              {{/options}}
            </div>
          </div>
        </div>
        {{/filters}}
      </div>
    </aside>
    {{/filtersenabled}}

    {{^filtersenabled}}
    <div class="col-12">
      <div class="alert alert-warning">{{#str}}nofilterenabled, local_coursefilter{{/str}}</div>
    </div>
    {{/filtersenabled}}

    <!-- Main Content -->
    <main class="col-12 col-md-8 col-lg-9">
      <div class="lc-searchbar mb-4 d-flex flex-wrap">
      <!-- Search input -->
      <div class="flex-grow-1 me-3">
        <input id="lc-search" class="form-control form-control-sm" type="text" placeholder="{{searchplaceholder}}" />
      </div>

      <!-- Sort by dropdown -->
      <div class="sort-by">
        <select id="lc-sort" class="form-select form-select-sm" style="min-width: 160px">
          <option value="popular">{{#str}} mostpopular, local_coursefilter {{/str}}</option>
          <option value="created">{{#str}} createddate, local_coursefilter {{/str}}</option>
          <option value="duration">{{#str}} duration, local_coursefilter {{/str}}</option>
        </select>
      </div>
    </div>



      <div id="lc-results">
        {{> local_coursefilter/coursegrid}}
      </div>
    </main>
  </div>
</div>

{{#js}}
require(['local_coursefilter/ui'], function(mod) {
    mod.init();
});
{{/js}}
