<?xml version="1.0" encoding="UTF-8"?>
<XMLDB PATH="mod/edztrackvideo/db" VERSION="2026062700" COMMENT="DB for edztrackvideo">
  <TABLES>
    <TABLE NAME="edztrackvideo" COMMENT="edztrackvideo main table">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="sourcetype" TYPE="char" LENGTH="16" NOTNULL="true" DEFAULT="youtube" SEQUENCE="false" COMMENT="youtube|vimeo|upload"/>
        <FIELD NAME="externalurl" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="original YouTube/Vimeo URL, or the Direct video URL"/>
        <FIELD NAME="videoid" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false" COMMENT="extracted YouTube id or Vimeo numeric id"/>
        <FIELD NAME="serverpath" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="relative path under the admin videobasedir (serverfile source)"/>
        <FIELD NAME="videohash" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false" COMMENT="Vimeo private hash"/>
        <FIELD NAME="enable_completion_percent" TYPE="int" LENGTH="1" NOTNULL="false" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="completion_threshold" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="100" SEQUENCE="false"/>
        <FIELD NAME="no_forward_seek_first_view" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="allow_speed" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="max_speed" TYPE="number" LENGTH="4" DECIMALS="2" NOTNULL="true" DEFAULT="1.00" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course" UNIQUE="false" FIELDS="course"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="edztrackvideo_progress" COMMENT="per-user progress">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="edztrackvideoid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="maxwatched" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="last_position" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="duration" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="first_view_done" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="completed" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="dismissed" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="lastupdate" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="last_viewed_on" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="edztrackvideoid" TYPE="foreign" FIELDS="edztrackvideoid" REFTABLE="edztrackvideo" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="edztrackvideoid-userid" UNIQUE="true" FIELDS="edztrackvideoid, userid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
