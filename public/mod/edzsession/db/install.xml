<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/edzsession/db" VERSION="2026072400" COMMENT="mod_edzsession — recurring live sessions with pluggable storage."
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="edzsession" COMMENT="EDZ Session activity instances.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="meetingprovider" TYPE="char" LENGTH="40" NOTNULL="true" DEFAULT="zoom" SEQUENCE="false"/>
        <FIELD NAME="accountid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="FK to edzsession_account."/>
        <FIELD NAME="remotemeetingid" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Provider meeting id (recurring parent)."/>
        <FIELD NAME="meetingstatus" TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="pending" SEQUENCE="false" COMMENT="pending|created|error."/>
        <FIELD NAME="storageprovider" TYPE="char" LENGTH="40" NOTNULL="false" SEQUENCE="false" COMMENT="Null = use site default."/>
        <FIELD NAME="storagefolderid" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="storagefoldername" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="schedulejson" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Recurrence spec."/>
        <FIELD NAME="autorecord" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="completionattendancepercent" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="completionminutes" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="completionsessions" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_course" UNIQUE="false" FIELDS="course"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="edzsession_account" COMMENT="Multi-account meeting credential vault (secrets encrypted).">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="provider" TYPE="char" LENGTH="40" NOTNULL="true" DEFAULT="zoom" SEQUENCE="false"/>
        <FIELD NAME="accountid" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="clientid" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="clientsecretenc" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Encrypted."/>
        <FIELD NAME="verificationtokenenc" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Encrypted."/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_provider_enabled" UNIQUE="false" FIELDS="provider, enabled"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="edzsession_occurrence" COMMENT="One scheduled sitting of a session.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="edzsessionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="remotemeetingid" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="remoteuuid" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="starttime" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="duration" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Scheduled minutes."/>
        <FIELD NAME="actualduration" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Actual seconds from report."/>
        <FIELD NAME="status" TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="scheduled" SEQUENCE="false"/>
        <FIELD NAME="joinurl" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_edzsession" TYPE="foreign" FIELDS="edzsessionid" REFTABLE="edzsession" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_uuid" UNIQUE="false" FIELDS="remoteuuid"/>
        <INDEX NAME="idx_session_start" UNIQUE="false" FIELDS="edzsessionid, starttime"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="edzsession_attendance" COMMENT="Reconciled attendance per user per occurrence.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="occurrenceid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="matchedname" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="matchedemail" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="joinseconds" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="attendedpercent" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="matchstate" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="unmatched" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_occurrence" TYPE="foreign" FIELDS="occurrenceid" REFTABLE="edzsession_occurrence" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_occ_user" UNIQUE="false" FIELDS="occurrenceid, userid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="edzsession_attendance_raw" COMMENT="Raw participant segments before reconcile.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="occurrenceid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="email" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="registrantid" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="jointime" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="leavetime" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_occurrence" TYPE="foreign" FIELDS="occurrenceid" REFTABLE="edzsession_occurrence" REFFIELDS="id"/>
      </KEYS>
    </TABLE>

    <TABLE NAME="edzsession_recording" COMMENT="Offload pipeline row per source recording (idempotent).">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="occurrenceid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="sourceuuid" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Idempotency key."/>
        <FIELD NAME="storageprovider" TYPE="char" LENGTH="40" NOTNULL="true" DEFAULT="none" SEQUENCE="false"/>
        <FIELD NAME="state" TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="discovered" SEQUENCE="false"/>
        <FIELD NAME="assetid" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="sourceurl" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Base provider download URL (re-tokenised per attempt)."/>
        <FIELD NAME="embedjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="sizebytes" TYPE="int" LENGTH="19" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="attempts" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="lasterror" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_occurrence" TYPE="foreign" FIELDS="occurrenceid" REFTABLE="edzsession_occurrence" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="uq_sourceuuid" UNIQUE="true" FIELDS="sourceuuid"/>
        <INDEX NAME="idx_state" UNIQUE="false" FIELDS="state"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="edzsession_pipeline_log" COMMENT="Audit of offload state transitions.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="recordingid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="fromstate" TYPE="char" LENGTH="30" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="tostate" TYPE="char" LENGTH="30" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="message" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_recording" TYPE="foreign" FIELDS="recordingid" REFTABLE="edzsession_recording" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
