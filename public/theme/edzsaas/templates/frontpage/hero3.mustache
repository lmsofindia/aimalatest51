{{#hero3enabled}}
<section class="edz-hero d-flex align-items-center justify-content-center text-center" style="background-image: url('{{hero3bg}}');background-color:{{herobgcolor}};">
  <div class="hero-overlay position-absolute top-0 start-0 w-100 h-100" style="background-color: {{herobgoverlay}};"></div>
  <div class="container position-relative z-2">
    <div class="hero3-content text-white">
      <h2 class="hero-title fw-bold" style="color:{{herotitlecolor}}">{{hero3title}}</h2>
      <p class="hero-subtitle" style="{{herodesccolor}}">{{hero3subtitle}}</p>
        <a href="{{hero3buttonurl}}" class="btn btn-lg mt-3 px-4 py-2"
           style="background-color: {{herobtnbgcolor}}; color: {{herobtntextcolor}}; border-radius: 10px;">
          {{hero3btntext}}
        </a>
    </div>
  </div>
</section>
{{/hero3enabled}}


