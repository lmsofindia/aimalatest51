{{#hero4enabled}}
<section class="edz-hero hero-style-4 d-flex align-items-center" style="background-image: url('{{{hero4bg}}}');background-color:{{herobgcolor}};">
 <div class="hero-overlay position-absolute top-0 start-0 w-100 h-100" style="background-color: {{herobgoverlay}};"></div>
  <div class="container py-5">
    <div class="row align-items-center text-center text-md-left">
      <div class="col-12 col-md-6 text-white mb-4 mb-md-0">
          <p  class="hero-subtitle"  class="mt-3"  style="color:{{herodesccolor}}">{{hero4desc}}</p>
          <h1 class="hero-title fw-bold" style="color:{{herotitlecolor}}">{{hero4title}}</h1>
      </div>
    </div>
  </div>
</section>
{{/hero4enabled}}




