{{#fcourseenabled}}
<section>
    <div style="background-color:{{coursecardbg}}" class="py-4">
        <div class="container mb-5">
            <div class="row">
                <div class="col-lg-12 text-center blockbgwhite-b mt-5">
                    <div class="section-title-fp hytext">
                        <h4  class="section-title-fp hytext">{{{coursecardtitle}}}</h2>
                        <p>{{{coursecardsubtitle}}}</p>

                    </div>
                </div>
            </div>

            <div class="row align-items-center gy-4">
                <!-- Left Side: Course Image -->
                <div class="col-lg-6 mb-2">
                    <div class="text-center fbgimg" style="background-image: url('{{{courseimage}}}');">
                        <a class="video-play" href="{{courseurl}}" target="_blank">
                        </a>
                    </div>
                </div>

                <!-- Right Side: Course Info -->
                <div class="col-lg-6">
                    <div class="single-choose-item mb-3 p-3 rounded" style="background-color: {{courseboxbgclr}};">
                        <h5 class="mb-3" style="color: {{coursenamecolor}};">{{coursename}}</h5>
                       <div class="d-flex flex-wrap align-items-center">
                            <p class="mb-0 me-3 course-info-block fixed-info-box" style="color: {{coursenamecolor}}; background-color: {{courseinfobgcolor}};">
                                <i class="fa fa-book me-1" style="color: {{courseinfotexticoncolor}};"></i> {{categoryname}}
                            </p>
                            <p class="mb-0 me-3 course-info-block fixed-info-box" style="color: {{datecolor}}; background-color: {{courseinfobgcolor}};">
                                <i class="fa fa-calendar-alt me-1" style="color: {{courseinfotexticoncolor}};"></i> {{startdate}}
                            </p>
                            <p class="mb-0 me-3 course-info-block fixed-info-box" style="color: {{enrolledcolor}}; background-color: {{courseinfobgcolor}};">
                                <i class="fa fa-users me-1" style="color: {{courseinfotexticoncolor}};"></i> {{enrolledusers}}
                            </p>
                        </div>
                        <div> <p class="featured-description mb-3" style="color: {{coursecarddesccolor}};background-color: {{courseinfobgcolor}};">{{{coursedescription}}}</p>
                        </div>
                      
                            <div class="hire-us-btn mt-2">
                                <a class="hybtn" href="{{courseurl}}">{{viewbtntext}}</a>
                            </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>
{{/fcourseenabled}}

