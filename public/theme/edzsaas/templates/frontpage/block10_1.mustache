<div class="custom-testimonial-slider container hy-mt-50">
  <div class="section-title-fp d-flex hytext">
    <h4>{{block10header}}</h4>
    <div class="d-block ms-auto p-2">
      <button class="btn-sm me-1 prev-btn" style="border-radius: 50%;">
        <i class="fa fa-chevron-left"></i>
      </button>
      <button class="btn-sm next-btn" style="border-radius: 50%;">
        <i class="fa fa-chevron-right"></i>
      </button>
    </div>
  </div>

  <div class="slider-wrapper overflow-hidden">
    <div class="slider-track d-flex transition">
      {{#block10}}
        <div class="testimonial-card p-3 flex-shrink-0">
          <div class="testimonial-content d-flex">
            <i class="fa fa-quote-left"></i>
            {{{block10caption}}}
          </div>
          <div class="author-details d-flex mt-2">
            <div class="author-img me-2">
              <img src="{{block10image}}" alt="" style="width: 50px; height: 50px; border-radius: 50%;">
            </div>
            <div class="author-content">
              <a href="{{block10linkurl}}" class="text-decoration-none fw-bold">{{block10name}}</a><br>
              <span>{{block10job}}</span>
            </div>
          </div>
        </div>
      {{/block10}}
    </div>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const track = document.querySelector(".slider-track");
  const cards = Array.from(document.querySelectorAll(".testimonial-card"));
  const prevBtn = document.querySelector(".prev-btn");
  const nextBtn = document.querySelector(".next-btn");

  const visibleCards = window.innerWidth < 768 ? 1 : 3;
  let currentIndex = visibleCards;

  // Clone cards for infinite loop
  const clonesBefore = cards.slice(-visibleCards).map(card => card.cloneNode(true));
  const clonesAfter = cards.slice(0, visibleCards).map(card => card.cloneNode(true));

  clonesBefore.forEach(clone => track.prepend(clone));
  clonesAfter.forEach(clone => track.append(clone));

  const allCards = Array.from(track.children);

  function updateSlider(animate = true) {
  const cardWidth = allCards[0].offsetWidth;
  const offset = cardWidth * currentIndex;

  track.style.transition = animate ? "transform 0.5s ease" : "none";
  track.style.transform = `translateX(-${offset}px)`;

  // Clear all active classes
  allCards.forEach(card => card.classList.remove("active"));

  // Calculate and apply active to middle visible card
  const middleVisibleIndex = currentIndex + Math.floor(visibleCards / 2);
  if (allCards[middleVisibleIndex]) {
    allCards[middleVisibleIndex].classList.add("active");
  }
}


  function moveNext() {
    currentIndex++;
    updateSlider();

    // Handle looping
    if (currentIndex >= allCards.length - visibleCards) {
      setTimeout(() => {
        currentIndex = visibleCards;
        updateSlider(false);
      }, 500);
    }
  }

  function movePrev() {
    currentIndex--;
    updateSlider();

    if (currentIndex < visibleCards) {
      setTimeout(() => {
        currentIndex = allCards.length - visibleCards * 2;
        updateSlider(false);
      }, 500);
    }
  }

  prevBtn.addEventListener("click", movePrev);
  nextBtn.addEventListener("click", moveNext);


  updateSlider(false);
});
</script>


