            </section>
            {{/fp_skills_has}}

            {{! ================================================================
                SECTION 2B — PHILOSOPHY  ("Why we built it differently")
                Dark full-bleed band, centred intro, 3 columns divided by
                hairlines: AI Roleplay / LMS / Proctoring.
                Content is intentionally hard-coded (no theme settings yet).
                ================================================================ }}
            {{#fp_philosophy_show}}
            <section class="edz-philosophy" aria-label="Why we built it differently">

                <div class="edz-philosophy__intro">
                    <p class="edz-philosophy__eyebrow">Our philosophy</p>
                    <h2 class="edz-philosophy__headline">
                        Why we built it <em>differently.</em>
                    </h2>
                    <p class="edz-philosophy__sub">
                        Every LMS tracks completions. Very few actually build capability.
                        We built EdzLMS around three ideas — practise it, learn it, prove it.
                    </p>
                </div>

                <div class="edz-philosophy__cols">

                    <div class="edz-philosophy__col">
                        <div class="edz-philosophy__icon edz-philosophy__icon--roleplay" aria-hidden="true">
                            <i class="fa fa-comments"></i>
                        </div>
                        <p class="edz-philosophy__kicker">AI roleplay</p>
                        <h3 class="edz-philosophy__title">Practise conversations before they happen for real.</h3>
                        <span class="edz-philosophy__rule" aria-hidden="true"></span>
                        <p class="edz-philosophy__body">
                            Reading about a difficult conversation is not the same as having one.
                            EdzLMS lets your people rehearse sales calls, client objections and
                            patient interactions against realistic AI personas — with instant,
                            specific feedback after every attempt.
                        </p>
                    </div>

                    <div class="edz-philosophy__col">
                        <div class="edz-philosophy__icon edz-philosophy__icon--lms" aria-hidden="true">
                            <i class="fa fa-bolt"></i>
                        </div>
                        <p class="edz-philosophy__kicker">The LMS core</p>
                        <h3 class="edz-philosophy__title">One platform for creation, delivery and tracking.</h3>
                        <span class="edz-philosophy__rule" aria-hidden="true"></span>
                        <p class="edz-philosophy__body">
                            Courses, paths, assessments and certificates in one place — with AI
                            at every layer, not bolted on as a feature. Build content faster,
                            personalise every learner journey, and see exactly where each team
                            stands at any moment.
                        </p>
                    </div>

                    <div class="edz-philosophy__col">
                        <div class="edz-philosophy__icon edz-philosophy__icon--proctoring" aria-hidden="true">
                            <i class="fa fa-circle-check"></i>
                        </div>
                        <p class="edz-philosophy__kicker">Secure proctoring</p>
                        <h3 class="edz-philosophy__title">Assessments your auditors can actually trust.</h3>
                        <span class="edz-philosophy__rule" aria-hidden="true"></span>
                        <p class="edz-philosophy__body">
                            Identity checks, environment monitoring and attempt analytics built
                            into every high-stakes assessment. Compliance training records that
                            are audit-ready on demand — no spreadsheets, no screenshots, no doubt.
                        </p>
                    </div>

                </div>

            </section>
            {{/fp_philosophy_show}}


            {{! ================================================================
                SECTION 4 — RECENTLY LAUNCHED COURSES
                2-column grid with left accent-border cards.
                Admin-selected course IDs, or falls back to 4 newest courses.
                ================================================================ }}
            {{#fp_has_courses}}
            <section class="edz-fp-courses">
                <p class="edz-fp-courses__heading">{{fp_courses_heading}}</p>
                <div class="edz-fp-courses__grid">
                    {{#fp_courses}}
                    <a href="{{url}}" class="edz-fp-course-card">
                        {{! Media: course image, or per-course gradient fallback }}
                        <div class="edz-fp-course-card__media{{^image}} edz-fp-course-card__media--{{gradclass}}{{/image}}">
                            {{#image}}<img src="{{image}}" alt="" loading="lazy">{{/image}}
                            {{#category}}<span class="edz-fp-course-card__tag">{{category}}</span>{{/category}}
                        </div>
                        <div class="edz-fp-course-card__body">
                            <h3 class="edz-fp-course-card__name">{{name}}</h3>
                            {{#summary}}
                            <p class="edz-fp-course-card__desc">{{summary}}</p>
                            {{/summary}}
